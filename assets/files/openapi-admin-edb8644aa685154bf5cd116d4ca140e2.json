{
 "openapi": "3.1.0",
 "info": {
  "title": "Nexwall Endpoint tenant administration API",
  "version": "1.0.0-preview",
  "description": "Served by the Controller on its own listener. Every call is scoped to the tenant of the bearer token; the tenant is never part of a URL or body, and another tenant's objects answer 404. Every change is written to the audit log before it is made (no record, no change) and again with its result. A store failure answers 503 and changes nothing. Preview: the contract may change before release."
 },
 "servers": [
  {
   "url": "https://controller.example/admin/v1",
   "description": "Replace with your Controller's administration address"
  }
 ],
 "security": [
  {
   "bearer": []
  }
 ],
 "tags": [
  {
   "name": "policy"
  },
  {
   "name": "devices"
  },
  {
   "name": "enrolment"
  },
  {
   "name": "audit"
  }
 ],
