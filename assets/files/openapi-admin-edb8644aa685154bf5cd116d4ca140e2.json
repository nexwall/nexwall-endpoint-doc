  "/devices/{device}/revoke": {
   "post": {
    "summary": "Revoke a device",
    "description": "Its certificate is refused on every route from then on (401). Repeating the call is harmless and keeps the first reason. A revocation is never undone because the audit record of its result could not be written.",
    "tags": [
     "devices"
    ],
    "security": [
     {
      "bearer": []
     }
    ],
    "responses": {
     "200": {
      "description": "Revoked"
     },
     "400": {
      "description": "Invalid input.",
      "content": {
